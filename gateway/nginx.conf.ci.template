# Plantilla SOLO-CI del gateway: no existen los backends de informes
# (testweb/jacocoweb/docweb no se construyen en CI), así que solo / y /api.
# El upstream apunta a 127.0.0.1 porque en CI el gateway corre con --network host.
upstream api {
    server 127.0.0.1:${API_PORT};
}

server {
    listen 8080;

    location = / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location = /api    { return 301 /api/; }

    location /api/ {
        proxy_pass http://api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
