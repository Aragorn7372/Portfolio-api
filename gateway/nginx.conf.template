# Puente local: http://localhost:8080
# Este fichero se incluye DENTRO del bloque http del nginx principal
# (la imagen lo vuelca en /etc/nginx/conf.d/default.conf):
# solo upstreams + server, sin events{} ni http{}.
# /         -> landing (html/)
# /api/     -> api:${API_PORT}/ (sin el prefijo)
# /tests/   -> testweb (informe de tests Gradle)
# /jacoco/  -> jacocoweb (cobertura JaCoCo)
# /docs/    -> docweb (Dokka, httpd)
upstream api {
    server api:${API_PORT};
}
upstream testweb {
    server testweb:80;
}
upstream jacocoweb {
    server jacocoweb:80;
}
upstream docweb {
    server docweb:80;
}

server {
    listen 80;

    # Prefijo (no exacto): tras la reescritura interna de index (/ -> /index.html)
    # la URI sigue casando aquí y mantiene el root.
    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location = /api    { return 301 /api/; }
    location = /tests  { return 301 /tests/; }
    location = /jacoco { return 301 /jacoco/; }
    location = /docs   { return 301 /docs/; }

    location /api/ {
        proxy_pass http://api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /tests/ {
        proxy_pass http://testweb/;
    }

    location /jacoco/ {
        proxy_pass http://jacocoweb/;
    }

    location /docs/ {
        proxy_pass http://docweb/;
    }
}
