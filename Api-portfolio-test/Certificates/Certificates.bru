meta {
  name: Certificates
  type: http
  seq: 1
}

get {
  url: {{hostname}}/certificates
  body: none
  auth: bearer
}

auth:bearer {
  token: {{visitJwt}}
}

script:post-response {
  test("status 200 con JWT", () => {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve la lista de certificados", () => {
    expect(res.getBody()).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

