meta {
  name: ProjectsWithCookie
  type: http
  seq: 2
}

get {
  url: {{hostname}}/projects
  body: none
  auth: none
}

headers {
  Cookie: visit_jwt={{visitJwt}}
}

script:post-response {
  test("status 200 con cookie", () => {
    expect(res.getStatus()).to.equal(200);
  });
  test("devuelve la lista de proyectos", () => {
    expect(res.getBody()).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
