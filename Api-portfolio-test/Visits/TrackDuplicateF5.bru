meta {
  name: TrackDuplicateF5
  type: http
  seq: 2
}

post {
  url: {{hostname}}/visits/track
  body: json
  auth: bearer
}

auth:bearer {
  token: {{visitJwt}}
}

body:json {
  {
    "userAgent": "bruno-test/1.0-{{runNonce}}",
    "language": "es-ES",
    "timezone": "Europe/Madrid",
    "screen": "1920x1080x24",
    "plugins": ["PDF Viewer"]
  }
}

script:post-response {
  const data = res.getBody();
  test("status 200", () => {
    expect(res.getStatus()).to.equal(200);
  });
  test("el F5 no cuenta", () => {
    expect(data.counted).to.equal(false);
  });
  test("el total no cambia", () => {
    expect(data.visits).to.equal(parseInt(bru.getVar("visitsAfterFirst")));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}


